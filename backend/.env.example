# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hypz_db

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRE=90d

# Email Configuration (for verification and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@hypz.io

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,application/pdf,text/plain,application/json

# Security
BCRYPT_ROUNDS=12
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Payment Gateway (Stripe/Razorpay)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Backblaze B2 Configuration
# Get these from your Backblaze B2 account: https://www.backblaze.com/b2/cloud-storage.html
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
# Create two buckets: one public (allPublic) and one private (allPrivate)
B2_PUBLIC_BUCKET_ID=your-public-bucket-id
B2_PUBLIC_BUCKET_NAME=your-public-bucket-name
B2_PRIVATE_BUCKET_ID=your-private-bucket-id
B2_PRIVATE_BUCKET_NAME=your-private-bucket-name
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com

# Admin Configuration
ADMIN_EMAIL=admin@hypz.io
