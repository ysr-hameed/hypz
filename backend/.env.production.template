# Hypz Backend - Production Environment Variables
# Copy this to .env and fill in your values

# CRITICAL - Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1

# CRITICAL - Database
DATABASE_URL=postgresql://username:password@host:5432/database

# CRITICAL - JWT Secrets (Use the generated values above)
JWT_SECRET=your_generated_jwt_secret_here
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_generated_refresh_secret_here
JWT_REFRESH_EXPIRE=90d

# CRITICAL - Backblaze B2
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_key
B2_PUBLIC_BUCKET_ID=your_public_bucket_id
B2_PUBLIC_BUCKET_NAME=your_public_bucket_name
B2_PRIVATE_BUCKET_ID=your_private_bucket_id
B2_PRIVATE_BUCKET_NAME=your_private_bucket_name
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Email Configuration (Recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@hypz.io

# Frontend URL
FRONTEND_URL=https://your-production-domain.com

# Security
BCRYPT_ROUNDS=12
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Payment - Lemon Squeezy (Optional)
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# Payment - Razorpay (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

