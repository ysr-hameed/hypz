# Production Environment Variables

# Mode
# VITE_MODE=production

# API Configuration
VITE_API_URL=https://api.hypz.io/api

# Security Settings (MUST be false in production)
VITE_BYPASS_AUTH_IN_DEV=false

# Disable mock data in production
VITE_ENABLE_MOCK_DATA=false

# Payment Provider Keys (Production Keys)
VITE_RAZORPAY_KEY=your_razorpay_production_key_here
VITE_LEMON_SQUEEZY_KEY=your_lemon_squeezy_production_key_here

# OAuth Credentials (Production)
VITE_GOOGLE_CLIENT_ID=your_google_production_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_production_client_id_here
VITE_MICROSOFT_CLIENT_ID=your_microsoft_production_client_id_here

# Debug (disabled in production)
VITE_DEBUG=false
