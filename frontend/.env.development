# Development Environment Variables

# Mode (automatically set by Vite, but you can override)
# VITE_MODE=development

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Security Settings
# Set to 'false' to enforce authentication even in development
VITE_BYPASS_AUTH_IN_DEV=true

# Enable mock data for development
VITE_ENABLE_MOCK_DATA=true

# Payment Provider Keys (Development/Test Keys)
VITE_RAZORPAY_KEY=your_razorpay_test_key_here
VITE_LEMON_SQUEEZY_KEY=your_lemon_squeezy_test_key_here

# OAuth Credentials (Development)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Debug
VITE_DEBUG=true
