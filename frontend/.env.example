# Frontend Environment Variables
# Copy this file to .env and update if needed

# API Configuration (auto-detected in development, required in production)
# Development: automatically uses http://localhost:5000/api/v1
# Production: uses window.location.origin + /api/v1 or override below
VITE_API_URL=http://localhost:5000/api/v1

# Admin Panel Password Protection
# SECURITY: Change this to a strong password immediately!
# This adds an extra layer of security to admin panel access
VITE_ADMIN_PASSWORD=your_secure_admin_password_here

# Note: All sensitive config (payment keys, OAuth credentials, etc.) 
# should be in backend .env and fetched via /api/v1/config/public
